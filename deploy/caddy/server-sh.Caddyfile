{
	auto_https off
}

:80 {
	@site host static.bluecdn.com static-edge.bluecdn.com origin-sh.bluecdn.com
	handle @site {
		encode gzip zstd
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		header Access-Control-Allow-Headers "*"
		@opt method OPTIONS
		respond @opt 204

		# 反代路径(jsDelivr+cdnjs)转发到硅谷源站
		@proxy path /npm/* /gh/* /wp/* /combine/* /esm/* /ajax/libs/*
		handle @proxy {
			reverse_proxy http://47.254.125.87 {
				header_up Host static.bluecdn.com
			}
		}

		# 本地静态
		handle {
			root * /www/sites/static.bluecdn.com
			@imm path *.woff2 *.woff
			header @imm Cache-Control "public, max-age=31536000, immutable"
			@short path *.css *.html /
			header @short Cache-Control "public, max-age=300, must-revalidate"
			file_server
		}
	}
}
