# 复制成 certs.env 并填入真实值；certs.env 已被 .gitignore 忽略，不会提交。
# ⚠️ 用过就泄露在聊天里的那几对，请先去控制台重置再填新的。

# 要签发证书的域名（空格分隔，可多个）
DOMAINS="static.bluecdn.com img.bluecdn.com"

# --- Cloudflare：用于 acme.sh 的 DNS-01 验证（不是给 CDN 用的）---
# 在 CF 控制台建一个 API Token，权限：Zone.DNS Edit（限定到 bluecdn.com 区域）
export CF_Token="你的_cloudflare_api_token"
# 可选：export CF_Account_ID="..."   export CF_Zone_ID="..."

# --- 百度云：用于把证书推到百度 CDN ---
export BAIDU_AK="重置后的_access_key"
export BAIDU_SK="重置后的_secret_key"

# --- Bunny（可选，仅当你用 API 上传而不是 Bunny Free SSL 时）---
export BUNNY_API_KEY="重置后的_bunny_api_key"
# 每个域名对应的 Bunny Pull Zone ID（按需填）
# BUNNY_ZONE_static_bluecdn_com="123456"
